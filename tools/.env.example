# Settings for the tools in this folder. Copy to tools/.env (not versioned) and edit.
# Lines are KEY=VALUE; lines starting with # are ignored.

# --- wsl-disk.ps1 ------------------------------------------------------------------------------
# Serial number of the external disk. In PowerShell:  Get-Disk | Format-List Number,FriendlyName,SerialNumber,BusType
# The serial is used instead of the disk number because the number changes between plugs.
WSL_DISK_SERIAL=XXXXXXXXXXXX

# Partition number to mount. In PowerShell:  Get-Partition -DiskNumber <N>
WSL_DISK_PARTITION=1

# Filesystem of that partition, as the WSL kernel knows it (ext4, btrfs, xfs, ...).
WSL_DISK_TYPE=ext4

# Mount name: the disk appears inside WSL at /mnt/wsl/<name>.
WSL_DISK_NAME=insertplay

# Windows drive letter, or "auto" to use the first free one (X, Y, Z, V, ...).
WSL_DISK_LETTER=auto

# WSL distro that serves the files. In PowerShell:  wsl -l -q
WSL_DISK_DISTRO=Ubuntu

# "true" mounts read-write. Anything else (or unset) mounts read-only, which is the safe default.
WSL_DISK_READWRITE=false

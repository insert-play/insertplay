{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build insertplay-cli",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "src/insertplay-cli/InsertPlay.Cli.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "src/insertplay-cli/InsertPlay.Cli.slnx"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "publish",
      "type": "shell",
      "command": "bash",
      "args": [
        "src/publish.sh"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "build-sd-card",
      "type": "shell",
      "command": "bash",
      "args": [
        "src/build-sd-card.sh"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}

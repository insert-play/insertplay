{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build insertplay-cli",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/insertplay-cli/InsertPlay.Cli.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "publish",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/src/insertplay-cli/InsertPlay.Cli.csproj",
        "-c",
        "Release",
        "-p:PublishSingleFile=true",
        "-p:SelfContained=true",
        "-r",
        "linux-x64",
        "-o",
        "${workspaceFolder}/publish"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch InsertPlay CLI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build insertplay-cli",
      "program": "${workspaceFolder}/src/insertplay-cli/bin/Debug/net8.0/InsertPlay.Cli.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/insertplay-cli",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": ".NET Launch InsertPlay CLI (C# Dev Kit)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/insertplay-cli/InsertPlay.Cli.csproj"
    }
  ]
}

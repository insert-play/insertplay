<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InsertPlay.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sibling layer projects live under this project's own directory; keep their sources out of this project's glob -->
    <Compile Remove="InsertPlay.Cli.*/**/*.cs" />
    <Content Remove="InsertPlay.Cli.*/**/*" />
    <None Remove="InsertPlay.Cli.*/**/*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Steam shortcut artwork, flattened into assets/ alongside the executable -->
    <Content Include="assets/steam-shortcuts/*.png" Link="assets/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- insertplay-service scripts are linked to the output root so install.sh / the CLI can find them alongside itself -->
    <Content Include="../insertplay-service/insertplay-service.sh" Link="insertplay-service.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../insertplay-service/insertplay-start-bootstrap.sh" Link="insertplay-start-bootstrap.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets/installer/install.sh" Link="install.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets/installer/uninstall.sh" Link="uninstall.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="InsertPlay.Cli.Application\InsertPlay.Cli.Application.csproj" />
    <ProjectReference Include="InsertPlay.Cli.Infrastructure\InsertPlay.Cli.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>
</Project>

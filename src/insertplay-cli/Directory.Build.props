<Project>
  <PropertyGroup>
    <!--
      Works around a known MSBuild issue when building a single project via a solution-level
      "/target:ProjectName" invocation (this is how VS Code's C# Dev Kit builds a project to run
      its tests): with a multi-level ProjectReference chain (Tests -> Infrastructure -> Application
      -> Domain), the reference assembly of a transitive dependency isn't produced in time, causing
      "CS0006: Metadata file '...\obj\Debug\net8.0\ref\X.dll' could not be found". Disabling reference
      assemblies makes the compiler use the full assembly instead, sidestepping the issue entirely.
    -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <!--
      This machine only has the .NET 10 runtime installed, but every project here targets net8.0
      (reference assemblies for net8.0 resolve fine via NuGet, so building is unaffected). Without
      this, any executable (the CLI itself, and the test host that runs InsertPlay.Cli.Tests) fails
      at run time with "You must install or update .NET to run this application." VS Code's Test
      Explorer swallows that failure and just shows "0/0 - test run did not record any output."
      RollForward lets the apphost fall back to the closest newer major version instead of demanding
      an exact net8.0 runtime. Harmless for the library projects (Domain/Application/Infrastructure),
      which don't produce a runtimeconfig.json/apphost at all.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
</Project>

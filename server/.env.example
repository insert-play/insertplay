# Copy to server/.env (not in git) and adjust. No secrets here: the token lives in
# $INSERTPLAY_CONFIG/token.env, mode 0600.
INSERTPLAY_LIBRARY=/mnt/games/InsertPlay
INSERTPLAY_CONFIG=/home/debian/.config/insertplay/remote-library
# Save server storage (issue #63): outside the library, so the indexer and Samba never see it
INSERTPLAY_SAVES=/mnt/games/InsertPlay-saves
# Backups kept per game (MB); a save larger than this gets no backup and still syncs
INSERTPLAY_SAVE_BACKUP_MB=50
INSERTPLAY_PORT=8080
INSERTPLAY_UID=1000
INSERTPLAY_GID=1000
